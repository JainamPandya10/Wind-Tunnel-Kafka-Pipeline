# Used when running services directly on your machine (not via docker compose),
# e.g. for local debugging. Inside docker compose these are already set
# per-service in docker-compose.yml and this file is not needed.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql://wt_user:wt_password@localhost:5432/wind_tunnel

# Producer tuning
READINGS_PER_SECOND=5
ANOMALY_PROBABILITY=0.05
